{
  "name": "tenbin",
  "version": "0.1.0",
  "description": "Tenbin: MCP server (harness) for the TypeSafe AI System One API (Jev): evaluate, batch, rank, taxonomy walk, question lint",
  "type": "module",
  "bin": {
    "tenbin": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "resources",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && cd dist && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  }
}
